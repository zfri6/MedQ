-  # ---------------- C 组：视频合成 ----------------
-  video_timing:
-    file: rtl/video_timing.v
-    domain: clk_pix
-    desc: "640x480@60 标准时序：H 640+16前肩+96同步+48后肩=800；V 480+10+2+33=525。HS/VS 负极性。"
-    params:
-      - {name: H_ACT,  default: 640}
-      - {name: H_FP,   default: 16}
-      - {name: H_SYNC, default: 96}
-      - {name: H_BP,   default: 48}
-      - {name: V_ACT,  default: 480}
-      - {name: V_FP,   default: 10}
-      - {name: V_SYNC, default: 2}
-      - {name: V_BP,   default: 33}
-    ports:
-      - {name: clk,         dir: in,  width: 1}
-      - {name: rst_n,       dir: in,  width: 1}
-      - {name: de,          dir: out, width: 1}
-      - {name: hs,          dir: out, width: 1}
-      - {name: vs,          dir: out, width: 1}
-      - {name: x,           dir: out, width: 10, desc: "有效区内列号 0..639，非有效区保持"}
-      - {name: y,          dir: out, width: 10, desc: "有效区内行号 0..479"}
