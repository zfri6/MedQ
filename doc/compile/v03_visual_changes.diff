-  bmp_parser:
-    file: rtl/bmp_parser.v
-    domain: clk_sys
-    desc: >
-      容错 BMP 解析。必须处理：bfType 校验 'BM'；任意 bfOffBits（跳过调色板/扩展头）；
-      biHeight 为负表示 top-down；行 4 字节对齐填充；24 位与 32 位；
-      biCompression 必须为 0（BI_RGB），否则报错；宽高超出 1024x1024 报错。
-      字节序为小端；像素字节序为 BGR(A)。输出为 top-down 顺序的 RGB888 像素流。
-    ports:
-      - {name: clk,        dir: in,  width: 1}
-      - {name: rst_n,      dir: in,  width: 1}
-      - {name: start,      dir: in,  width: 1}
-      - {name: in_valid,   dir: in,  width: 1,  desc: "文件字节流"}
-      - {name: in_data,    dir: in,  width: 8}
-      - {name: hdr_valid,  dir: out, width: 1,  desc: "头解析完成，单周期脉冲"}
-      - {name: img_width,  dir: out, width: 11}
-      - {name: img_height, dir: out, width: 11}
-      - {name: img_bpp,    dir: out, width: 6}
-      - {name: img_topdown,dir: out, width: 1}
-      - {name: px_valid,   dir: out, width: 1}
-      - {name: px_rgb,     dir: out, width: 24, desc: "{R,G,B}"}
-      - {name: px_x,       dir: out, width: 11}
-      - {name: px_y,       dir: out, width: 11, desc: "始终为 top-down 行号"}
-      - {name: done,       dir: out, width: 1}
-      - {name: err,        dir: out, width: 1}
-      - {name: err_code,   dir: out, width: 4,  desc: "1=非BM 2=压缩不支持 3=位深不支持 4=尺寸越界 5=数据截断"}
-
-  asset_loader:
-    file: rtl/asset_loader.v
-    domain: clk_sys
-    desc: >
-      素材载入编排器。上电后：挂载 FAT32 -> 枚举 *.BMP 建立图片表 -> 枚举 *.PCM 建立语音表
-      -> 把全部 PCM 顺序搬进 SDRAM AUDIO_POOL 并登记偏移 -> 把第 0 张 BMP 解码写入 FB0
-      -> 置 assets_ok。之后响应换图请求，把第 N 张 BMP 解码写入指定帧缓存。
-      写 SDRAM 走 sdram_master_port（前缀 wr_），需要跨 clk_sys -> clk_mem，用 al_ip 的
-      afifo_8i_32o_1024 做字节到字的宽度转换与跨域。
-    ports:
-      - {name: clk_sys,     dir: in,  width: 1}
-      - {name: rst_n_sys,   dir: in,  width: 1}
-      - {name: clk_mem,     dir: in,  width: 1}
-      - {name: rst_n_mem,   dir: in,  width: 1}
-      - {name: load_req,    dir: in,  width: 1,  desc: "请求载入第 img_sel 张图到 fb_sel"}
-      - {name: img_sel,     dir: in,  width: 5}
-      - {name: fb_sel,      dir: in,  width: 2,  desc: "0=FB0 1=FB1 2=FB2"}
-      - {name: load_busy,   dir: out, width: 1}
-      - {name: load_done,   dir: out, width: 1}
-      - {name: load_err,    dir: out, width: 1}
-      - {name: img_count,   dir: out, width: 6}
-      - {name: pcm_count,   dir: out, width: 6}
-      - {name: assets_ok,   dir: out, width: 1}
-      - {name: progress,    dir: out, width: 4,  desc: "0..15 载入进度，供 OSD 显示"}
-      - {name: clip_sel,    dir: in,  width: 5,  desc: "查询第 N 个语音片段的位置"}
-      - {name: clip_base,   dir: out, width: 22, desc: "该片段在 AUDIO_POOL 的字地址"}
-      - {name: clip_samples,dir: out, width: 22, desc: "该片段样本数（16 kHz）"}
-      - {name: sd_spi_sclk, dir: out, width: 1}
-      - {name: sd_spi_mosi, dir: out, width: 1}
-      - {name: sd_spi_miso, dir: in,  width: 1}
-      - {name: sd_spi_cs_n, dir: out, width: 1}
-      - {name: wr_req_valid,dir: out, width: 1}
-      - {name: wr_req_ready,dir: in,  width: 1}
-      - {name: wr_req_addr, dir: out, width: 22}
-      - {name: wr_req_we,   dir: out, width: 1}
-      - {name: wr_req_len,  dir: out, width: 9}
-      - {name: wr_wr_valid, dir: out, width: 1}
-      - {name: wr_wr_ready, dir: in,  width: 1}
-      - {name: wr_wr_data,  dir: out, width: 32}
-      - {name: wr_rd_valid, dir: in,  width: 1}
-      - {name: wr_rd_ready, dir: out, width: 1}
-      - {name: wr_rd_data,  dir: in,  width: 32}
