-      - {name: rst_n_mem,    dir: in,  width: 1}
-      - {name: fb_base,      dir: in,  width: 22, desc: "本帧要显示的帧缓存基地址，帧起始时采样"}
-      - {name: frame_start,  dir: in,  width: 1}
-      - {name: line_start,   dir: in,  width: 1}
-      - {name: de,           dir: in,  width: 1}
-      - {name: px_rgb,       dir: out, width: 24}
-      - {name: underrun,     dir: out, width: 1}
-      - {name: disp_req_valid, dir: out, width: 1}
-      - {name: disp_req_ready, dir: in,  width: 1}
-      - {name: disp_req_addr,  dir: out, width: 22}
-      - {name: disp_req_we,    dir: out, width: 1}
-      - {name: disp_req_len,   dir: out, width: 9}
-      - {name: disp_wr_valid,  dir: out, width: 1}
-      - {name: disp_wr_ready,  dir: in,  width: 1}
-      - {name: disp_wr_data,   dir: out, width: 32}
-      - {name: disp_rd_valid,  dir: in,  width: 1}
-      - {name: disp_rd_ready,  dir: out, width: 1}
-      - {name: disp_rd_data,   dir: in,  width: 32}
