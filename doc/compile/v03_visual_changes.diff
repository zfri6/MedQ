-  # ---------------- D 组：业务控制 ----------------
-  queue_fsm:
-    file: rtl/queue_fsm.v
-    domain: clk_sys
-    desc: >
-      叫号队列状态机。4 个诊室，普通队列与优先队列各一。
-      公平策略：优先号先服务，但连续服务优先号不超过 PRIO_BURST 个，之后必须让一个普通号，防止普通队列饿死。
-      支持：叫下一号、重呼（不推进队列，repeat_cnt+1）、过号（当前号作废并回写到普通队列尾部）、
-      自动模式（每 AUTO_PERIOD 个时钟自动叫号并模拟患者到达）。
-    params:
-      - {name: ROOMS,       default: 4}
-      - {name: PRIO_BURST,  default: 2}
-      - {name: AUTO_PERIOD, default: 250000000, desc: "5 秒 @50MHz"}
-    ports:
-      - {name: clk,          dir: in,  width: 1}
-      - {name: rst_n,        dir: in,  width: 1}
-      - {name: ev_next,      dir: in,  width: 1, desc: "叫下一号"}
-      - {name: ev_recall,    dir: in,  width: 1, desc: "重呼"}
-      - {name: ev_skip,      dir: in,  width: 1, desc: "过号"}
-      - {name: ev_page,      dir: in,  width: 1, desc: "切换页面"}
-      - {name: ev_arrive,    dir: in,  width: 1, desc: "新患者取号"}
-      - {name: sw_priority,  dir: in,  width: 1, desc: "取号时标记为优先号"}
-      - {name: sw_auto,      dir: in,  width: 1, desc: "自动叫号模式"}
-      - {name: sw_access,    dir: in,  width: 1, desc: "适老化模式"}
-      - {name: restore_req,  dir: in,  width: 1, desc: "上电从 Flash 恢复队列"}
-      - {name: restore_data, dir: in,  width: 128}
-      - {name: persist_data, dir: out, width: 128, desc: "要保存到 Flash 的状态"}
-      - {name: persist_req,  dir: out, width: 1,  desc: "状态变化，请求持久化"}
-      - {name: qstate,       dir: out, width: 128, desc: "见 qstate_bus"}
-      - {name: call_pulse,   dir: out, width: 1,  desc: "发生一次叫号，触发语音与延迟测量"}
-      - {name: call_ticket,  dir: out, width: 16, desc: "本次叫号票号 BCD"}
-      - {name: call_room,    dir: out, width: 4}
-      - {name: call_prio,    dir: out, width: 1}
