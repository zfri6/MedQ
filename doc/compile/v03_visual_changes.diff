-  uart_cmd:
-    file: rtl/uart_cmd.v
-    domain: clk_sys
-    desc: >
-      调试命令解析。帧格式：0x55 0xAA CMD ROOM TICKET_H TICKET_L PARAM CRC8。
-      CRC8 多项式 0x07，初值 0x00，覆盖 CMD..PARAM 共 5 字节。
-      CMD: 0x01 叫下一号 0x02 重呼 0x03 过号 0x04 取号 0x05 设置参数 0x06 切页。
-      校验失败丢弃整帧并回 0x15，成功回 0x06。UART 仅用于调试，最终作品不依赖它运行。
-    ports:
-      - {name: clk,       dir: in,  width: 1}
-      - {name: rst_n,     dir: in,  width: 1}
-      - {name: rx_valid,  dir: in,  width: 1}
-      - {name: rx_data,   dir: in,  width: 8}
-      - {name: tx_valid,  dir: out, width: 1}
-      - {name: tx_ready,  dir: in,  width: 1}
-      - {name: tx_data,   dir: out, width: 8}
-      - {name: cmd_next,  dir: out, width: 1}
-      - {name: cmd_recall,dir: out, width: 1}
-      - {name: cmd_skip,  dir: out, width: 1}
-      - {name: cmd_arrive,dir: out, width: 1}
-      - {name: cmd_page,  dir: out, width: 1}
-      - {name: cmd_param_we,  dir: out, width: 1}
-      - {name: cmd_param_sel, dir: out, width: 4}
-      - {name: cmd_param_val, dir: out, width: 8}
-
-  seg_scan:
-    file: rtl/seg_scan.v
-    domain: clk_sys
-    desc: "8 位数码管动态扫描，1 kHz 单位刷新。段码共阳/共阴由 SEG_ACTIVE_LOW 参数控制。"
-    params:
-      - {name: CLK_HZ, default: 50000000}
-      - {name: SCAN_HZ, default: 1000}
-      - {name: SEG_ACTIVE_LOW, default: 1}
-      - {name: SEL_ACTIVE_LOW, default: 1}
-    ports:
-      - {name: clk,      dir: in,  width: 1}
-      - {name: rst_n,    dir: in,  width: 1}
-      - {name: digits,   dir: in,  width: 32, desc: "8 个 4-bit 值，digit0 在低位"}
-      - {name: dp,       dir: in,  width: 8,  desc: "小数点"}
-      - {name: blank,    dir: in,  width: 8,  desc: "1=该位熄灭"}
-      - {name: seg_data, dir: out, width: 8,  desc: "{dp,g,f,e,d,c,b,a}"}
-      - {name: seg_sel,  dir: out, width: 8}
-
-  buzzer:
-    file: rtl/buzzer.v
-    domain: clk_sys
-    desc: "蜂鸣器提示音。三种音型：普通叫号双响、重呼三响、优先号长响。"
-    params: [{name: CLK_HZ, default: 50000000}]
-    ports:
-      - {name: clk,     dir: in,  width: 1}
-      - {name: rst_n,   dir: in,  width: 1}
-      - {name: trig,    dir: in,  width: 1}
-      - {name: pattern, dir: in,  width: 2, desc: "0=普通 1=重呼 2=优先"}
-      - {name: mute,    dir: in,  width: 1}
-      - {name: beep,    dir: out, width: 1}
-      - {name: busy,    dir: out, width: 1}
-
-  param_ctrl:
-    file: rtl/param_ctrl.v
-    domain: clk_sys
-    desc: >
-      实时参数调节。KEY 组合 + 拨码选择当前调节项，长按连续增减。
-      输出 param_bus，并产生一个 OSD 提示，3 秒后自动隐藏。
-    ports:
-      - {name: clk,          dir: in,  width: 1}
-      - {name: rst_n,        dir: in,  width: 1}
-      - {name: key_press,    dir: in,  width: 4}
-      - {name: key_hold,     dir: in,  width: 4}
-      - {name: sw,           dir: in,  width: 4}
-      - {name: ext_we,       dir: in,  width: 1, desc: "来自 uart_cmd"}
-      - {name: ext_sel,      dir: in,  width: 4}
-      - {name: ext_val,      dir: in,  width: 8}
-      - {name: param,        dir: out, width: 64}
-      - {name: osd_hint_id,  dir: out, width: 4, desc: "当前正在调节哪一项，0=无"}
-      - {name: osd_hint_val, dir: out, width: 8}
-      - {name: osd_hint_vis, dir: out, width: 1}
-
-  # ---------------- E 组：音频 ----------------
-  audio_sample_clk:
-    file: rtl/audio_sample_clk.v
-    domain: clk_pix
-    desc: >
-      由 clk_pix 用分数累加器产生精确 48 kHz 选通。
-      累加器每拍加 ACC_INC，溢出即产生 stb。ACC_INC = 48000 * 2^32 / 25000000 = 8246337.2,
-      取 8246337 时误差 < 0.03 ppm，与 ACR 的 N/CTS 比值一致，构造上不漂移。
-    params:
-      - {name: ACC_W,   default: 32}
-      - {name: ACC_INC, default: 8246337}
-    ports:
-      - {name: clk,   dir: in,  width: 1}
-      - {name: rst_n, dir: in,  width: 1}
-      - {name: stb,   dir: out, width: 1}
-
-  audio_tone_gen:
-    file: rtl/audio_tone_gen.v
-    domain: clk_pix
-    desc: "48 kHz 测试音与提示音。1/4 周期正弦查表 256 点，相位累加器合成任意频率。满足基础要求 3 的测试音。"
-    ports:
-      - {name: clk,       dir: in,  width: 1}
-      - {name: rst_n,     dir: in,  width: 1}
-      - {name: stb,       dir: in,  width: 1}
-      - {name: enable,    dir: in,  width: 1}
-      - {name: freq_inc,  dir: in,  width: 24, desc: "相位增量，f = freq_inc * 48000 / 2^24"}
-      - {name: amplitude, dir: in,  width: 8}
-      - {name: sample,    dir: out, width: 16, desc: "有符号"}
-
-  audio_pcm_player:
-    file: rtl/audio_pcm_player.v
-    domain: clk_pix
-    desc: >
-      从 SDRAM AUDIO_POOL 播放语音片段。素材为 16 kHz 16-bit 单声道，2 样本/32-bit 字。
-      播放时用线性插值 3 倍上采样到 48 kHz（相位累加器 1/3 步进）。
-      跨 clk_mem -> clk_pix 用异步 FIFO，深度 >= 512 样本，保证不欠载。
-    ports:
-      - {name: clk_pix,    dir: in,  width: 1}
-      - {name: rst_n_pix,  dir: in,  width: 1}
-      - {name: clk_mem,    dir: in,  width: 1}
-      - {name: rst_n_mem,  dir: in,  width: 1}
-      - {name: stb,        dir: in,  width: 1}
-      - {name: play_req,   dir: in,  width: 1}
-      - {name: play_base,  dir: in,  width: 22}
-      - {name: play_samples,dir: in, width: 22}
-      - {name: play_busy,  dir: out, width: 1}
-      - {name: play_done,  dir: out, width: 1}
-      - {name: sample,     dir: out, width: 16}
-      - {name: underrun,   dir: out, width: 1}
-      - {name: aud_req_valid, dir: out, width: 1}
-      - {name: aud_req_ready, dir: in,  width: 1}
-      - {name: aud_req_addr,  dir: out, width: 22}
-      - {name: aud_req_we,    dir: out, width: 1}
-      - {name: aud_req_len,   dir: out, width: 9}
-      - {name: aud_wr_valid,  dir: out, width: 1}
-      - {name: aud_wr_ready,  dir: in,  width: 1}
-      - {name: aud_wr_data,   dir: out, width: 32}
-      - {name: aud_rd_valid,  dir: in,  width: 1}
-      - {name: aud_rd_ready,  dir: out, width: 1}
-      - {name: aud_rd_data,   dir: in,  width: 32}
-
-  audio_announcer:
-    file: rtl/audio_announcer.v
-    domain: clk_pix
-    desc: >
-      叫号语音编排器。收到 call_pulse 后，把一次播报拆成片段序列并依次请求 pcm 播放：
-      提示音 -> 字母 -> 百位 -> 十位 -> 个位 -> "号请到" -> 诊室号 -> "诊室就诊"。
-      片段索引到 SDRAM 地址的映射由 asset_loader 的 clip_base/clip_samples 查询端口提供。
-    params: [{name: MAX_STEPS, default: 12}]
-    ports:
-      - {name: clk,          dir: in,  width: 1}
-      - {name: rst_n,        dir: in,  width: 1}
-      - {name: call_pulse,   dir: in,  width: 1}
-      - {name: call_ticket,  dir: in,  width: 16}
-      - {name: call_room,    dir: in,  width: 4}
-      - {name: call_prio,    dir: in,  width: 1}
-      - {name: call_recall,  dir: in,  width: 1}
-      - {name: clip_sel,     dir: out, width: 5}
-      - {name: clip_base,    dir: in,  width: 22}
-      - {name: clip_samples, dir: in,  width: 22}
-      - {name: play_req,     dir: out, width: 1}
-      - {name: play_base,    dir: out, width: 22}
-      - {name: play_samples, dir: out, width: 22}
-      - {name: play_busy,    dir: in,  width: 1}
-      - {name: play_done,    dir: in,  width: 1}
-      - {name: announcing,   dir: out, width: 1}
-
-  audio_mixer:
-    file: rtl/audio_mixer.v
-    domain: clk_pix
-    desc: "混合提示音与语音，施加音量，饱和截断防止溢出，输出立体声（双声道同值）。"
-    ports:
-      - {name: clk,     dir: in,  width: 1}
-      - {name: rst_n,   dir: in,  width: 1}
-      - {name: stb,     dir: in,  width: 1}
-      - {name: tone_in, dir: in,  width: 16}
-      - {name: pcm_in,  dir: in,  width: 16}
-      - {name: volume,  dir: in,  width: 8}
-      - {name: aud_l,   dir: out, width: 16}
-      - {name: aud_r,   dir: out, width: 16}
-
-  goertzel_spectrum:
-    file: rtl/goertzel_spectrum.v
-    domain: clk_pix
-    desc: >
-      16 点 Goertzel 频谱。每 BLOCK_N 个采样输出一组 16 个 bin 的能量。
-      每个 bin 一个二阶递推 s[n] = x[n] + coef*s[n-1] - s[n-2]，coef 为 Q2.14 常数查表。
-      16 个 bin 时分复用同一个乘法器阵列（每采样 16 次乘加，48kHz*16=768k 次/秒，
-      在 25 MHz 下绰绰有余），因此只消耗 1~2 个硬件乘法器而不是 16 个。
-    params:
-      - {name: BINS,    default: 16}
-      - {name: BLOCK_N, default: 256}
-    ports:
-      - {name: clk,       dir: in,  width: 1}
-      - {name: rst_n,     dir: in,  width: 1}
-      - {name: stb,       dir: in,  width: 1}
-      - {name: sample,    dir: in,  width: 16}
-      - {name: bin_valid, dir: out, width: 1,  desc: "一组结果就绪"}
-      - {name: bin_idx,   dir: out, width: 4}
-      - {name: bin_mag,   dir: out, width: 8,  desc: "对数压缩后的幅度 0..255"}
-      - {name: level,     dir: out, width: 8,  desc: "整体音量包络，供音量条用"}
-
-  spectrum_render:
-    file: rtl/spectrum_render.v
-    domain: clk_pix
-    desc: "把频谱/波形/音量条画成 RGB+alpha 层，固定位置在画面右下角 192x96 区域。"
-    ports:
-      - {name: clk,         dir: in,  width: 1}
-      - {name: rst_n,       dir: in,  width: 1}
-      - {name: x,           dir: in,  width: 10}
-      - {name: y,           dir: in,  width: 10}
-      - {name: de,          dir: in,  width: 1}
-      - {name: frame_start, dir: in,  width: 1}
-      - {name: mode,        dir: in,  width: 4}
-      - {name: bin_valid,   dir: in,  width: 1}
-      - {name: bin_idx,     dir: in,  width: 4}
-      - {name: bin_mag,     dir: in,  width: 8}
-      - {name: level,       dir: in,  width: 8}
-      - {name: sample,      dir: in,  width: 16}
-      - {name: stb,         dir: in,  width: 1}
-      - {name: spec_rgb,    dir: out, width: 24}
-      - {name: spec_alpha,  dir: out, width: 8}
-
-  # ---------------- F 组：SDRAM ----------------
-  sdram_arbiter:
-    file: rtl/sdram_arbiter.v
-    domain: clk_mem
-    desc: >
-      4 主 1 从仲裁。优先级 aud > disp > tr > wr，wr 带防饿死计数器：
-      连续被拒 STARVE_MAX 次后临时升到最高优先级。
-      仲裁粒度是整笔突发（突发内不抢占），保证 SDRAM 页命中率。
-    params: [{name: STARVE_MAX, default: 64}]
-    ports:
-      - {name: clk,   dir: in, width: 1}
-      - {name: rst_n, dir: in, width: 1}
-      - {name: "aud_* / disp_* / tr_* / wr_*", dir: "见 buses.sdram_master_port", width: "-",
-         desc: "4 组主端口，每组 12 根信号，前缀分别为 aud_ disp_ tr_ wr_"}
-      - {name: "mem_*", dir: "见 buses.sdram_master_port", width: "-",
-         desc: "1 组从端口，前缀 mem_，连到 sdram_ctrl_wrap"}
-
-  sdram_ctrl_wrap:
-    file: rtl/sdram_ctrl_wrap.v
-    domain: clk_mem
-    desc: >
-      片内 SDRAM 控制器封装（黑盒）。对上提供 sdram_master_port 从端口。
-      `ifdef SIMULATION 时直接接 tb/sdram_model.v 的简单同步存储行为；
-      否则例化安路 SDRAM 控制器 IP —— 该分支待 6_EG4S20 手册/APUG010/APUG011 到位后补全。
-      这是全设计第二个允许出现厂商原语的文件。
-    ports:
-      - {name: clk,   dir: in, width: 1}
-      - {name: rst_n, dir: in, width: 1}
-      - {name: "mem_*", dir: "见 buses.sdram_master_port", width: "-", desc: "从端口"}
-      - {name: init_done, dir: out, width: 1}
-
-  # ---------------- G 组：差异化特性 ----------------
-  latency_probe:
-    file: rtl/latency_probe.v
-    domain: "clk_sys + clk_pix"
-    desc: >
-      响应延迟测量。按键消抖沿在 clk_sys 起表，该次叫号结果首次被合成进帧时
-      （clk_pix 域 frame_start 且 qstate 已更新）停表。
-      输出微秒数与帧数，供 OSD 显示。这项直接量化赛题主张的"低显示延迟"。
-    params: [{name: CLK_SYS_HZ, default: 50000000}]
-    ports:
-      - {name: clk_sys,    dir: in,  width: 1}
-      - {name: rst_n_sys,  dir: in,  width: 1}
-      - {name: clk_pix,    dir: in,  width: 1}
-      - {name: rst_n_pix,  dir: in,  width: 1}
-      - {name: start_evt,  dir: in,  width: 1,  desc: "clk_sys 域，按键沿"}
-      - {name: stop_evt,   dir: in,  width: 1,  desc: "clk_pix 域，画面已更新"}
-      - {name: lat_us,     dir: out, width: 16, desc: "clk_pix 域，微秒"}
-      - {name: lat_frames, dir: out, width: 8,  desc: "clk_pix 域，帧数"}
-      - {name: lat_valid,  dir: out, width: 1}
-
-  av_sync_monitor:
-    file: rtl/av_sync_monitor.v
-    domain: clk_pix
-    desc: >
-      音画同步举证。统计每帧内的音频采样数（理论值 48000/60=800），
-      累计偏差换算成 ppm，并输出实测 fs。让"音视频同步"从打勾变成可展示的数字。
-    ports:
-      - {name: clk,         dir: in,  width: 1}
-      - {name: rst_n,       dir: in,  width: 1}
-      - {name: frame_start, dir: in,  width: 1}
-      - {name: aud_stb,     dir: in,  width: 1}
-      - {name: samples_per_frame, dir: out, width: 12}
-      - {name: fs_measured_hz,    dir: out, width: 20}
-      - {name: drift_ppm,         dir: out, width: 16, desc: "有符号"}
-
-  spi_flash_store:
-    file: rtl/spi_flash_store.v
-    domain: clk_sys
-    desc: >
-      队列状态持久化到板载 SPI NOR Flash。标准命令：0x03 读、0x02 页编程、
-      0x20 扇区擦除、0x05 读状态、0x06 写使能。
-      采用双槽轮换 + 32 位 CRC，避免掉电写坏导致恢复失败。
-      引脚待原理图确认；仿真用 tb/spi_flash_model.v。
-    params: [{name: SLOT_A_ADDR, default: 0x000000}, {name: SLOT_B_ADDR, default: 0x001000}]
-    ports:
-      - {name: clk,        dir: in,  width: 1}
-      - {name: rst_n,      dir: in,  width: 1}
-      - {name: save_req,   dir: in,  width: 1}
-      - {name: save_data,  dir: in,  width: 128}
-      - {name: save_busy,  dir: out, width: 1}
-      - {name: save_done,  dir: out, width: 1}
-      - {name: load_req,   dir: in,  width: 1}
-      - {name: load_data,  dir: out, width: 128}
-      - {name: load_valid, dir: out, width: 1}
-      - {name: load_fail,  dir: out, width: 1}
-      - {name: fl_sclk,    dir: out, width: 1}
-      - {name: fl_mosi,    dir: out, width: 1}
-      - {name: fl_miso,    dir: in,  width: 1}
-      - {name: fl_cs_n,    dir: out, width: 1}
