+# ============================================================================
+# 本文件是所有 RTL 的唯一端口事实来源。
+# 任何模块的端口名 / 位宽 / 方向 / 有效电平必须与此处逐字一致。
+# 若实现中发现契约有误，回到本文件修改并记录，不得在 RTL 里静默偏离。
+# ============================================================================
+
+global:
+  reset_polarity: active_low
+  reset_style: "async assert, sync release, one synchroniser per clock domain"
+  vendor_primitive_policy: >
+    功能模块内一律不得出现 EG_PHY_* / EG_LOGIC_* 原语。
+    厂商原语只允许出现在 rtl/al_ip/*.v 与 rtl/tmds_serdes.v 的 `ifdef 分支里。
+    目的：在 TD 未安装的情况下，所有功能模块都能被 iverilog / ModelSim 直接仿真。
+
+clock_domains:
+  - name: clk_sys
+    freq_mhz: 50
+    source: "board oscillator clk50mhz @ R7 (直连，不过 PLL)"
+    reset: rst_n_sys
+    owns: [key_debounce, queue_fsm, uart_rx, uart_tx, uart_cmd, seg_scan, buzzer,
+           param_ctrl, sd_spi_master, sd_card_ctrl, fat32_reader, bmp_parser,
+           asset_loader, spi_flash_store, latency_probe]
+  - name: clk_mem
+    freq_mhz: 100
+    source: "PLL 输出（TD 装好后生成；当前仿真用 TB 直接产生）"
+    reset: rst_n_mem
+    owns: [sdram_arbiter, sdram_ctrl_wrap]
+  - name: clk_pix
+    freq_mhz: 25.0
+    source: "clk_wize PLL C1"
+    reset: rst_n_pix
+    owns: [video_timing, frame_reader, transition_engine, osd_renderer,
+           osd_compositor, bilinear_scaler, hdmi_tx_core, hdmi_packet_scheduler,
+           hdmi_audio_buffer, audio_sample_clk, audio_tone_gen, audio_pcm_player,
+           audio_mixer, goertzel_spectrum, av_sync_monitor]
+  - name: clk_ser
+    freq_mhz: 125.0
+    source: "clk_wize PLL C0"
+    reset: rst_n_pix   # 同源同步释放
+    owns: [tmds_serdes]
+
+# ============================================================================
+# 共享总线契约
+# ============================================================================
+
+buses:
+
+  # --------------------------------------------------------------------------
+  # SDRAM 主端口。4 个主设备使用完全相同的信号形状，前缀不同。
+  # 域：clk_mem。握手：valid/ready，同拍握手成立即视为传输。
+  # --------------------------------------------------------------------------
+  sdram_master_port:
+    domain: clk_mem
+    prefix_examples: [disp_, aud_, wr_, tr_]
+    signals:
+      - {name: "<p>req_valid", dir: "master->slave", width: 1,  desc: "请求有效"}
+      - {name: "<p>req_ready", dir: "slave->master", width: 1,  desc: "仲裁器接受请求"}
+      - {name: "<p>req_addr",  dir: "master->slave", width: 22, desc: "字地址（32-bit 字），0..2097151"}
+      - {name: "<p>req_we",    dir: "master->slave", width: 1,  desc: "1=写 0=读"}
+      - {name: "<p>req_len",   dir: "master->slave", width: 9,  desc: "突发长度（字），有效值 1..256"}
+      - {name: "<p>wr_valid",  dir: "master->slave", width: 1,  desc: "写数据有效"}
+      - {name: "<p>wr_ready",  dir: "slave->master", width: 1,  desc: "写数据被接收"}
+      - {name: "<p>wr_data",   dir: "master->slave", width: 32, desc: "写数据"}
+      - {name: "<p>rd_valid",  dir: "slave->master", width: 1,  desc: "读数据有效"}
+      - {name: "<p>rd_ready",  dir: "master->slave", width: 1,  desc: "读数据被接收"}
+      - {name: "<p>rd_data",   dir: "slave->master", width: 32, desc: "读数据"}
+    rules:
+      - "req 握手成功后，master 必须连续提供/接收恰好 req_len 个数据拍，不得中途放弃。"
+      - "同一 master 在前一笔突发的数据相位未结束前不得发起新的 req。"
+      - "读突发地址线性递增，不跨越 2M 字边界（上游保证）。"
+
+  # --------------------------------------------------------------------------
+  # 像素流。域：clk_pix。与视频时序严格对齐，无反压。
+  # --------------------------------------------------------------------------
+  pixel_stream:
+    domain: clk_pix
+    signals:
+      - {name: "<p>_de",   width: 1,  desc: "有效显示区"}
+      - {name: "<p>_hs",   width: 1,  desc: "行同步，负极性（640x480@60 标准）"}
+      - {name: "<p>_vs",   width: 1,  desc: "场同步，负极性"}
+      - {name: "<p>_rgb",  width: 24, desc: "{R[7:0],G[7:0],B[7:0]}"}
+    note: "所有视频级联模块必须保持 de/hs/vs 与 rgb 的相位一致；每级流水都要同步打拍。"
+
+  # --------------------------------------------------------------------------
+  # 音频采样流。域：clk_pix，48 kHz 选通。
+  # --------------------------------------------------------------------------
+  audio_stream:
+    domain: clk_pix
+    signals:
+      - {name: "<p>_stb",  width: 1,  desc: "48 kHz 单周期选通脉冲"}
+      - {name: "<p>_l",    width: 16, desc: "左声道，有符号"}
+      - {name: "<p>_r",    width: 16, desc: "右声道，有符号"}
+
+  # --------------------------------------------------------------------------
+  # 队列状态总线 QSTATE：128 bit 打包，clk_sys 产生，整体 CDC 到 clk_pix。
+  # 打包成一根宽总线是为了让跨时钟域只需要一个握手，避免各字段撕裂。
+  # --------------------------------------------------------------------------
+  qstate_bus:
+    width: 128
+    producer_domain: clk_sys
+    consumer_domain: clk_pix
+    cdc: cdc_bus_handshake
+    fields:
+      - {bits: "15:0",    name: cur_ticket_bcd,   desc: "当前票号 4 位 BCD，高位在前"}
+      - {bits: "23:16",   name: cur_prefix_ascii, desc: "票号字母前缀 ASCII，'A'=0x41 普通，'P'=0x50 优先"}
+      - {bits: "27:24",   name: cur_room,         desc: "当前叫号诊室 1..4，0=无"}
+      - {bits: "31:28",   name: repeat_cnt,       desc: "本票号已呼叫次数 1..15"}
+      - {bits: "32",      name: is_priority,      desc: "当前为优先号"}
+      - {bits: "33",      name: is_recall,        desc: "本次为重呼"}
+      - {bits: "34",      name: auto_mode,        desc: "自动叫号模式"}
+      - {bits: "35",      name: accessibility,    desc: "适老化大字高对比模式"}
+      - {bits: "43:36",   name: waiting_count,    desc: "等待人数 0..255"}
+      - {bits: "47:44",   name: page_id,          desc: "0=候诊 1=导诊 2=公告 3=工程诊断"}
+      - {bits: "63:48",   name: room0_ticket_bcd, desc: "1 号诊室当前票号 BCD"}
+      - {bits: "79:64",   name: room1_ticket_bcd, desc: "2 号诊室"}
+      - {bits: "95:80",   name: room2_ticket_bcd, desc: "3 号诊室"}
+      - {bits: "111:96",  name: room3_ticket_bcd, desc: "4 号诊室"}
+      - {bits: "115:112", name: room_busy,        desc: "各诊室忙标志，bit0=1 号诊室"}
+      - {bits: "119:116", name: next_head_lo,     desc: "队首下一号个位 BCD（候诊列表用）"}
+      - {bits: "127:120", name: sys_status,       desc: "bit0 sd_ready, bit1 assets_ok, bit2 audio_busy, bit3 sdram_ok, bit7:4 载入进度 0..15"}
+
+  # --------------------------------------------------------------------------
+  # 参数总线 PARAM：64 bit 打包，clk_sys 产生，CDC 到 clk_pix。
+  # --------------------------------------------------------------------------
+  param_bus:
+    width: 64
+    producer_domain: clk_sys
+    consumer_domain: clk_pix
+    cdc: cdc_bus_handshake
+    fields:
+      - {bits: "7:0",   name: brightness,      desc: "0..255，128 为中性，线性偏置"}
+      - {bits: "15:8",  name: contrast,        desc: "0..255，128 为中性，Q4.4 增益"}
+      - {bits: "23:16", name: volume,          desc: "0..255 线性音量"}
+      - {bits: "31:24", name: subtitle_speed,  desc: "字幕滚动速度，像素/帧，0=停"}
+      - {bits: "35:32", name: transition_mode, desc: "0=无 1=淡入淡出 2=左滑 3=右滑 4=擦除"}
+      - {bits: "39:36", name: spectrum_mode,   desc: "0=关 1=柱状谱 2=波形 3=音量条"}
+      - {bits: "43:40", name: osd_layer_en,    desc: "bit0 文字层 bit1 频谱层 bit2 字幕层 bit3 诊断层"}
+      - {bits: "63:44", name: reserved,        desc: "保留，写 0"}
+
+  # --------------------------------------------------------------------------
+  # OSD 文字域寄存器写端口。clk_sys 侧写入，内部做 CDC。
+  # --------------------------------------------------------------------------
+  osd_write_port:
+    domain: clk_sys
+    signals:
+      - {name: osd_we,    width: 1,  desc: "写使能，单周期"}
+      - {name: osd_addr,  width: 10, desc: "0..255=字符RAM（12bit字形索引）; 512..527=域表项"}
+      - {name: osd_wdata, width: 32, desc: "见 osd_field_entry / osd_char_entry"}
+    osd_char_entry:
+      bits: "11:0 glyph_index（字模ROM索引）; 其余位写 0"
+    osd_field_entry:
+      bits: >
+        0     enable;
+        10:1  x 起始像素;
+        20:11 y 起始像素;
+        22:21 scale (0=1x 1=2x 2=3x 3=4x);
+        26:23 len 字符数 1..15;
+        31:27 char_base>>3 （字符RAM起始地址的高5位，起始地址 = char_base<<3）
+      note: "颜色与样式由 osd_field_color 单独一组地址写入，见 osd_renderer 端口说明。"
+
+# ============================================================================
+# SDRAM 内存映射（32-bit 字地址）
+# ============================================================================
+sdram_map:
+  total_words: 2097152      # 2M x 32bit = 8 MByte
+  pixel_format: "1 pixel per 32-bit word, {8'h00, R[7:0], G[7:0], B[7:0]}"
+  addressing: "addr = base + y*640 + x"
+  regions:
+    - {name: FB0,        base: 0x000000, words: 307200, desc: "帧缓存 A（当前显示）"}
+    - {name: FB1,        base: 0x04B000, words: 307200, desc: "帧缓存 B（下一张图）"}
+    - {name: FB2,        base: 0x096000, words: 307200, desc: "转场/合成暂存"}
+    - {name: AUDIO_POOL, base: 0x0E1000, words: 716800, desc: "语音素材池，16 kHz 16-bit 单声道，2 样本/字，约 87 秒"}
+    - {name: SPARE,      base: 0x18F000, words: 462848, desc: "余量"}
+  bandwidth_budget:
+    sdram_peak_mword_s: 100
+    display_read_mword_s: 18.432   # 640*480*60
+    crossfade_extra_mword_s: 18.432
+    audio_read_mword_s: 0.024
+    utilisation_normal: "18.5%"
+    utilisation_crossfade: "37%"
+    note: "双 HDMI 同源双视图不增加读带宽：帧缓存只读一次，合成两路 OSD。"
+
+# ============================================================================
+# 模块端口契约
+# ============================================================================
+modules:
+
+  # ---------------- 基础设施 ----------------
+  rst_sync:
+    file: rtl/rst_sync.v
+    domain: any
+    params: [{name: POR_CYCLES, default: 50000, desc: "无 pll_locked 时的上电计数（50000 @50MHz = 1ms）"}]
+    ports:
+      - {name: clk,        dir: in,  width: 1}
+      - {name: ext_rst_n,  dir: in,  width: 1, desc: "外部异步复位，低有效；无外部复位时接 1'b1"}
+      - {name: pll_locked, dir: in,  width: 1, desc: "PLL 锁定；无该信号时接 1'b1，由 POR_CYCLES 兜底"}
+      - {name: rst_n_out,  dir: out, width: 1, desc: "异步置位、同步释放的域内复位"}
+
+  cdc_sync_bit:
+    file: rtl/cdc_sync_bit.v
+    params: [{name: STAGES, default: 2}, {name: INIT, default: 0}]
+    ports:
+      - {name: clk,   dir: in,  width: 1}
+      - {name: rst_n, dir: in,  width: 1}
+      - {name: d_in,  dir: in,  width: 1}
+      - {name: d_out, dir: out, width: 1}
+
+  cdc_pulse:
+    file: rtl/cdc_pulse.v
+    desc: "单周期脉冲跨域，握手式，src 侧 busy 期间丢弃新脉冲"
+    ports:
+      - {name: src_clk,   dir: in,  width: 1}
+      - {name: src_rst_n, dir: in,  width: 1}
+      - {name: src_pulse, dir: in,  width: 1}
+      - {name: src_busy,  dir: out, width: 1}
+      - {name: dst_clk,   dir: in,  width: 1}
+      - {name: dst_rst_n, dir: in,  width: 1}
+      - {name: dst_pulse, dir: out, width: 1}
+
+  cdc_bus_handshake:
+    file: rtl/cdc_bus_handshake.v
+    desc: "宽总线跨域，四相握手，保证目的侧看到的是同一拍采样的完整向量"
+    params: [{name: W, default: 128}]
+    ports:
+      - {name: src_clk,   dir: in,  width: 1}
+      - {name: src_rst_n, dir: in,  width: 1}
+      - {name: src_data,  dir: in,  width: W}
+      - {name: dst_clk,   dir: in,  width: 1}
+      - {name: dst_rst_n, dir: in,  width: 1}
+      - {name: dst_data,  dir: out, width: W}
+
+  key_debounce:
+    file: rtl/key_debounce.v
+    domain: clk_sys
+    params: [{name: N, default: 4}, {name: CNT_MAX, default: 500000, desc: "10 ms @50MHz"}]
+    ports:
+      - {name: clk,         dir: in,  width: 1}
+      - {name: rst_n,       dir: in,  width: 1}
+      - {name: key_in_n,    dir: in,  width: N, desc: "板级按键，低有效（按下=0）"}
+      - {name: key_level,   dir: out, width: N, desc: "消抖后电平，高=按下"}
+      - {name: key_press,   dir: out, width: N, desc: "按下沿单周期脉冲"}
+      - {name: key_release, dir: out, width: N, desc: "释放沿单周期脉冲"}
+      - {name: key_hold,    dir: out, width: N, desc: "长按 1 秒持续为高"}
+
+  # ---------------- A 组：HDMI 发送器 ----------------
+  hdmi_tmds_encoder:
+    file: rtl/hdmi_tmds_encoder.v
+    domain: clk_pix
+    desc: "DVI/HDMI 视频期 8b/10b TMDS 编码（最小跳变 + DC 平衡），控制期输出 4 个控制码"
+    ports:
+      - {name: clk,    dir: in,  width: 1}
+      - {name: rst_n,  dir: in,  width: 1}
+      - {name: din,    dir: in,  width: 8,  desc: "像素分量"}
+      - {name: c,      dir: in,  width: 2,  desc: "控制位 {c1,c0}"}
+      - {name: de,     dir: in,  width: 1,  desc: "1=视频期编码 din，0=控制期编码 c"}
+      - {name: dout,   dir: out, width: 10, desc: "TMDS 符号，1 拍延迟"}
+
+  hdmi_terc4_encoder:
+    file: rtl/hdmi_terc4_encoder.v
+    domain: clk_pix
+    desc: "数据岛期 TERC4 4b/10b 查表编码"
+    ports:
+      - {name: din,  dir: in,  width: 4}
+      - {name: dout, dir: out, width: 10, desc: "组合逻辑输出，无延迟"}
+
+  hdmi_bch_ecc:
+    file: rtl/hdmi_bch_ecc.v
+    domain: clk_pix
+    desc: "HDMI 数据岛 BCH(64,56) ECC，生成多项式 x^8+x^7+x^6+x^4+x^2+1 (0xD5)，逐 bit 串行"
+    ports:
+      - {name: clk,     dir: in,  width: 1}
+      - {name: rst_n,   dir: in,  width: 1}
+      - {name: clear,   dir: in,  width: 1, desc: "清零 LFSR，开始新的一组"}
+      - {name: shift_en,dir: in,  width: 1, desc: "移入一个 bit"}
+      - {name: bit_in,  dir: in,  width: 1}
+      - {name: ecc_out, dir: out, width: 8, desc: "当前 LFSR 状态即校验字节"}
+
+  hdmi_packet_scheduler:
+    file: rtl/hdmi_packet_scheduler.v
+    domain: clk_pix
+    desc: >
+      组装并轮转调度 HDMI 数据岛包：Audio Clock Regeneration (0x01)、
+      Audio Sample (0x02)、AVI InfoFrame (0x82)、Audio InfoFrame (0x84)。
+      输出 36 字节包体（1 个 header 3 字节 + 4 个 subpacket 各 7 字节）供数据岛发送。
+    params:
+      - {name: ACR_N,   default: 6144, desc: "48 kHz 标准 N 值"}
+      - {name: ACR_CTS, default: 25000, desc: "25.000 MHz TMDS 下的 CTS，fs 精确等于 48000"}
+    ports:
+      - {name: clk,         dir: in,  width: 1}
+      - {name: rst_n,       dir: in,  width: 1}
+      - {name: aud_stb,     dir: in,  width: 1,  desc: "48 kHz 采样选通"}
+      - {name: aud_l,       dir: in,  width: 16}
+      - {name: aud_r,       dir: in,  width: 16}
+      - {name: pkt_req,     dir: in,  width: 1,  desc: "数据岛控制器请求下一个包"}
+      - {name: pkt_ack,     dir: out, width: 1,  desc: "包已就绪"}
+      - {name: pkt_header,  dir: out, width: 24, desc: "HB0,HB1,HB2"}
+      - {name: pkt_sub0,    dir: out, width: 56}
+      - {name: pkt_sub1,    dir: out, width: 56}
+      - {name: pkt_sub2,    dir: out, width: 56}
+      - {name: pkt_sub3,    dir: out, width: 56}
+      - {name: aud_overflow,dir: out, width: 1,  desc: "音频 FIFO 溢出（诊断用）"}
+      - {name: aud_underflow,dir: out,width: 1,  desc: "音频 FIFO 欠载（诊断用）"}
+
+  hdmi_tx_core:
+    file: rtl/hdmi_tx_core.v
+    domain: clk_pix
+    desc: >
+      HDMI 1.4b 发送器核心。按 HDMI 规范编排控制期 / 前导码 / 保护带 / 数据岛 / 视频期，
+      输出 3 路 10-bit TMDS 符号。这是自研部分，替代官方加密的 DVITransmitter。
+    ports:
+      - {name: clk,        dir: in,  width: 1}
+      - {name: rst_n,      dir: in,  width: 1}
+      - {name: vid_de,     dir: in,  width: 1}
+      - {name: vid_hs,     dir: in,  width: 1, desc: "负极性输入"}
+      - {name: vid_vs,     dir: in,  width: 1, desc: "负极性输入"}
+      - {name: vid_rgb,    dir: in,  width: 24}
+      - {name: aud_stb,    dir: in,  width: 1}
+      - {name: aud_l,      dir: in,  width: 16}
+      - {name: aud_r,      dir: in,  width: 16}
+      - {name: tmds_ch0,   dir: out, width: 10, desc: "蓝 + HS/VS"}
+      - {name: tmds_ch1,   dir: out, width: 10, desc: "绿"}
+      - {name: tmds_ch2,   dir: out, width: 10, desc: "红"}
+      - {name: aud_overflow,  dir: out, width: 1}
+      - {name: aud_underflow, dir: out, width: 1}
+
+  tmds_serdes:
+    file: rtl/tmds_serdes.v
+    domain: "clk_pix + clk_ser"
+    desc: >
+      10:1 串化器薄封装。`ifdef SIMULATION 时用行为级模型（可仿真）；
+      否则例化 EG4 DDR 输出原语（待 6_EG4S20 手册确认原语名后补全该分支）。
+      这是全设计唯一允许出现厂商原语的自研文件。
+    ports:
+      - {name: clk_pix,  dir: in,  width: 1}
+      - {name: clk_ser,  dir: in,  width: 1}
+      - {name: rst_n,    dir: in,  width: 1}
+      - {name: din,      dir: in,  width: 10, desc: "并行 TMDS 符号，clk_pix 域"}
+      - {name: sdata_p,  dir: out, width: 1,  desc: "LVDS 正端，TD 自动推差分对"}
+
+  # ---------------- B 组：存储链路 ----------------
+  sd_spi_master:
+    file: rtl/sd_spi_master.v
+    domain: clk_sys
+    desc: "SPI 模式 0 主控（CPOL=0 CPHA=0：上升沿采样，下降沿驱动）。分频可运行时切换，初始化用 400 kHz，之后切 12.5 MHz。"
+    ports:
+      - {name: clk,       dir: in,  width: 1}
+      - {name: rst_n,     dir: in,  width: 1}
+      - {name: clk_div,   dir: in,  width: 8,  desc: "SCLK = clk_sys / (2*(clk_div+1))"}
+      - {name: tx_valid,  dir: in,  width: 1}
+      - {name: tx_ready,  dir: out, width: 1}
+      - {name: tx_data,   dir: in,  width: 8}
+      - {name: rx_valid,  dir: out, width: 1}
+      - {name: rx_data,   dir: out, width: 8}
+      - {name: busy,      dir: out, width: 1}
+      - {name: spi_sclk,  dir: out, width: 1}
+      - {name: spi_mosi,  dir: out, width: 1}
+      - {name: spi_miso,  dir: in,  width: 1}
+
+  sd_card_ctrl:
+    file: rtl/sd_card_ctrl.v
+    domain: clk_sys
+    desc: >
+      SD 卡 SPI 模式初始化与扇区读。阶段顺序固定：
+      74+ 空闲时钟 -> CMD0 -> CMD8 -> (ACMD41 轮询直到 idle=0) -> CMD58 读 OCR 判 SDHC -> CMD16(块长512，仅 SDSC)
+      -> 就绪。读用 CMD17（单块）。SDHC 用块地址，SDSC 用字节地址，由 OCR 的 CCS 位决定。
+    ports:
+      - {name: clk,        dir: in,  width: 1}
+      - {name: rst_n,      dir: in,  width: 1}
+      - {name: rd_req,     dir: in,  width: 1,  desc: "扇区读请求，单周期脉冲"}
+      - {name: rd_lba,     dir: in,  width: 32, desc: "逻辑扇区号"}
+      - {name: rd_busy,    dir: out, width: 1}
+      - {name: rd_done,    dir: out, width: 1,  desc: "整扇区读完，单周期脉冲"}
+      - {name: rd_err,     dir: out, width: 1,  desc: "超时或响应错误，单周期脉冲"}
+      - {name: byte_valid, dir: out, width: 1}
+      - {name: byte_data,  dir: out, width: 8}
+      - {name: byte_idx,   dir: out, width: 9,  desc: "0..511 扇区内偏移"}
+      - {name: card_ready, dir: out, width: 1,  desc: "初始化完成"}
+      - {name: card_sdhc,  dir: out, width: 1}
+      - {name: init_fail,  dir: out, width: 1}
+      - {name: spi_sclk,   dir: out, width: 1}
+      - {name: spi_mosi,   dir: out, width: 1}
+      - {name: spi_miso,   dir: in,  width: 1}
+      - {name: spi_cs_n,   dir: out, width: 1}
+
+  fat32_reader:
+    file: rtl/fat32_reader.v
+    domain: clk_sys
+    desc: >
+      只读 FAT32 解析。流程：读 LBA0 判 MBR（0x55AA + 分区表）或直接 BPB ->
+      定位分区起始 -> 解析 BPB（每扇区字节数/每簇扇区数/保留扇区/FAT 数/FAT 扇区数/根目录簇）
+      -> 遍历根目录项，按 8.3 名匹配扩展名 -> 输出文件起始簇与长度 -> 按簇链顺序输出文件字节流。
+      只支持 FAT32，不支持长文件名（用 8.3 短名匹配），不支持子目录（只扫根目录）。
+    ports:
+      - {name: clk,          dir: in,  width: 1}
+      - {name: rst_n,        dir: in,  width: 1}
+      - {name: mount_req,    dir: in,  width: 1,  desc: "启动挂载"}
+      - {name: mount_done,   dir: out, width: 1}
+      - {name: mount_err,    dir: out, width: 1}
+      - {name: scan_req,     dir: in,  width: 1,  desc: "开始枚举根目录"}
+      - {name: scan_ext,     dir: in,  width: 24, desc: "要匹配的扩展名 ASCII 大写，如 \"BMP\"/\"PCM\""}
+      - {name: file_valid,   dir: out, width: 1,  desc: "枚举到一个文件，单周期脉冲"}
+      - {name: file_index,   dir: out, width: 5,  desc: "第几个匹配文件 0..31"}
+      - {name: file_size,    dir: out, width: 32}
+      - {name: file_cluster, dir: out, width: 32}
+      - {name: scan_done,    dir: out, width: 1}
+      - {name: file_count,   dir: out, width: 6}
+      - {name: read_req,     dir: in,  width: 1,  desc: "开始顺序读某文件"}
+      - {name: read_cluster, dir: in,  width: 32, desc: "该文件起始簇"}
+      - {name: read_len,     dir: in,  width: 32, desc: "要读的字节数"}
+      - {name: read_busy,    dir: out, width: 1}
+      - {name: read_done,    dir: out, width: 1}
+      - {name: read_err,     dir: out, width: 1}
+      - {name: out_ready,    dir: in,  width: 1, desc: "反压；out_valid && out_ready 同拍消费一字节"}
+      - {name: out_valid,    dir: out, width: 1}
+      - {name: out_data,     dir: out, width: 8}
+      - {name: sd_rd_req,    dir: out, width: 1,  desc: "接 sd_card_ctrl"}
+      - {name: sd_rd_lba,    dir: out, width: 32}
+      - {name: sd_rd_done,   dir: in,  width: 1}
+      - {name: sd_rd_err,    dir: in,  width: 1}
+      - {name: sd_byte_valid,dir: in,  width: 1}
+      - {name: sd_byte_data, dir: in,  width: 8}
+
+  bmp_parser:
+    file: rtl/bmp_parser.v
+    domain: clk_sys
+    desc: >
+      容错 BMP 解析。必须处理：bfType 校验 'BM'；任意 bfOffBits（跳过调色板/扩展头）；
+      biHeight 为负表示 top-down；行 4 字节对齐填充；24 位与 32 位；
+      biCompression 必须为 0（BI_RGB），否则报错；宽高超出 1024x1024 报错。
+      字节序为小端；像素字节序为 BGR(A)。输出为 top-down 顺序的 RGB888 像素流。
+    ports:
+      - {name: clk,        dir: in,  width: 1}
+      - {name: rst_n,      dir: in,  width: 1}
+      - {name: start,      dir: in,  width: 1}
+      - {name: in_valid,   dir: in,  width: 1,  desc: "文件字节流"}
+      - {name: in_data,    dir: in,  width: 8}
+      - {name: hdr_valid,  dir: out, width: 1,  desc: "头解析完成，单周期脉冲"}
+      - {name: img_width,  dir: out, width: 11}
+      - {name: img_height, dir: out, width: 11}
+      - {name: img_bpp,    dir: out, width: 6}
+      - {name: img_topdown,dir: out, width: 1}
+      - {name: px_valid,   dir: out, width: 1}
+      - {name: px_rgb,     dir: out, width: 24, desc: "{R,G,B}"}
+      - {name: px_x,       dir: out, width: 11}
+      - {name: px_y,       dir: out, width: 11, desc: "始终为 top-down 行号"}
+      - {name: done,       dir: out, width: 1}
+      - {name: err,        dir: out, width: 1}
+      - {name: err_code,   dir: out, width: 4,  desc: "1=非BM 2=压缩不支持 3=位深不支持 4=尺寸越界 5=数据截断"}
+
+  asset_loader:
+    file: rtl/asset_loader.v
+    domain: clk_sys
+    desc: >
+      素材载入编排器。上电后：挂载 FAT32 -> 枚举 *.BMP 建立图片表 -> 枚举 *.PCM 建立语音表
+      -> 把全部 PCM 顺序搬进 SDRAM AUDIO_POOL 并登记偏移 -> 把第 0 张 BMP 解码写入 FB0
+      -> 置 assets_ok。之后响应换图请求，把第 N 张 BMP 解码写入指定帧缓存。
+      写 SDRAM 走 sdram_master_port（前缀 wr_），需要跨 clk_sys -> clk_mem，用 al_ip 的
+      afifo_8i_32o_1024 做字节到字的宽度转换与跨域。
+    ports:
+      - {name: clk_sys,     dir: in,  width: 1}
+      - {name: rst_n_sys,   dir: in,  width: 1}
+      - {name: clk_mem,     dir: in,  width: 1}
+      - {name: rst_n_mem,   dir: in,  width: 1}
+      - {name: load_req,    dir: in,  width: 1,  desc: "请求载入第 img_sel 张图到 fb_sel"}
+      - {name: img_sel,     dir: in,  width: 5}
+      - {name: fb_sel,      dir: in,  width: 2,  desc: "0=FB0 1=FB1 2=FB2"}
+      - {name: load_busy,   dir: out, width: 1}
+      - {name: load_done,   dir: out, width: 1}
+      - {name: load_err,    dir: out, width: 1}
+      - {name: img_count,   dir: out, width: 6}
+      - {name: pcm_count,   dir: out, width: 6}
+      - {name: assets_ok,   dir: out, width: 1}
+      - {name: progress,    dir: out, width: 4,  desc: "0..15 载入进度，供 OSD 显示"}
+      - {name: clip_sel,    dir: in,  width: 5,  desc: "查询第 N 个语音片段的位置"}
+      - {name: clip_base,   dir: out, width: 22, desc: "该片段在 AUDIO_POOL 的字地址"}
+      - {name: clip_samples,dir: out, width: 22, desc: "该片段样本数（16 kHz）"}
+      - {name: sd_spi_sclk, dir: out, width: 1}
+      - {name: sd_spi_mosi, dir: out, width: 1}
+      - {name: sd_spi_miso, dir: in,  width: 1}
+      - {name: sd_spi_cs_n, dir: out, width: 1}
+      - {name: wr_req_valid,dir: out, width: 1}
+      - {name: wr_req_ready,dir: in,  width: 1}
+      - {name: wr_req_addr, dir: out, width: 22}
+      - {name: wr_req_we,   dir: out, width: 1}
+      - {name: wr_req_len,  dir: out, width: 9}
+      - {name: wr_wr_valid, dir: out, width: 1}
+      - {name: wr_wr_ready, dir: in,  width: 1}
+      - {name: wr_wr_data,  dir: out, width: 32}
+      - {name: wr_rd_valid, dir: in,  width: 1}
+      - {name: wr_rd_ready, dir: out, width: 1}
+      - {name: wr_rd_data,  dir: in,  width: 32}
+
+  # ---------------- C 组：视频合成 ----------------
+  video_timing:
+    file: rtl/video_timing.v
+    domain: clk_pix
+    desc: "640x480@60 标准时序：H 640+16前肩+96同步+48后肩=800；V 480+10+2+33=525。HS/VS 负极性。"
+    params:
+      - {name: H_ACT,  default: 640}
+      - {name: H_FP,   default: 16}
+      - {name: H_SYNC, default: 96}
+      - {name: H_BP,   default: 48}
+      - {name: V_ACT,  default: 480}
+      - {name: V_FP,   default: 10}
+      - {name: V_SYNC, default: 2}
+      - {name: V_BP,   default: 33}
+    ports:
+      - {name: clk,         dir: in,  width: 1}
+      - {name: rst_n,       dir: in,  width: 1}
+      - {name: de,          dir: out, width: 1}
+      - {name: hs,          dir: out, width: 1}
+      - {name: vs,          dir: out, width: 1}
+      - {name: x,           dir: out, width: 10, desc: "有效区内列号 0..639，非有效区保持"}
+      - {name: y,          dir: out, width: 10, desc: "有效区内行号 0..479"}
+      - {name: frame_start, dir: out, width: 1,  desc: "每帧第一个有效像素前一拍"}
+      - {name: line_start,  dir: out, width: 1}
+      - {name: frame_cnt,   dir: out, width: 16}
+
+  frame_reader:
+    file: rtl/frame_reader.v
+    domain: clk_pix
+    desc: >
+      从 SDRAM 预取像素供显示。跨 clk_mem -> clk_pix，用异步 FIFO 缓冲至少 2 行（1280 字）。
+      每行提前发起突发读，保证 de 期间永不欠载；欠载时输出洋红色并置 underrun 标志便于诊断。
+    ports:
+      - {name: clk_pix,      dir: in,  width: 1}
+      - {name: rst_n_pix,    dir: in,  width: 1}
+      - {name: clk_mem,      dir: in,  width: 1}
+      - {name: rst_n_mem,    dir: in,  width: 1}
+      - {name: fb_base,      dir: in,  width: 22, desc: "本帧要显示的帧缓存基地址，帧起始时采样"}
+      - {name: frame_start,  dir: in,  width: 1}
+      - {name: line_start,   dir: in,  width: 1}
+      - {name: de,           dir: in,  width: 1}
+      - {name: px_rgb,       dir: out, width: 24}
+      - {name: underrun,     dir: out, width: 1}
+      - {name: disp_req_valid, dir: out, width: 1}
+      - {name: disp_req_ready, dir: in,  width: 1}
+      - {name: disp_req_addr,  dir: out, width: 22}
+      - {name: disp_req_we,    dir: out, width: 1}
+      - {name: disp_req_len,   dir: out, width: 9}
+      - {name: disp_wr_valid,  dir: out, width: 1}
+      - {name: disp_wr_ready,  dir: in,  width: 1}
+      - {name: disp_wr_data,   dir: out, width: 32}
+      - {name: disp_rd_valid,  dir: in,  width: 1}
+      - {name: disp_rd_ready,  dir: out, width: 1}
+      - {name: disp_rd_data,   dir: in,  width: 32}
+
+  transition_engine:
+    file: rtl/transition_engine.v
+    domain: clk_pix
+    desc: >
+      转场。模式 2/3/4（左滑/右滑/擦除）只改地址映射，不增加带宽，由本模块输出
+      fb_base_sel 与像素选择信号实现；模式 1（淡入淡出）需要第二路帧读取器，
+      按 alpha 做逐像素混合。alpha 每帧线性递增 256/DURATION。
+    ports:
+      - {name: clk,          dir: in,  width: 1}
+      - {name: rst_n,        dir: in,  width: 1}
+      - {name: start,        dir: in,  width: 1,  desc: "启动一次转场"}
+      - {name: mode,         dir: in,  width: 4,  desc: "见 param_bus.transition_mode"}
+      - {name: duration,     dir: in,  width: 8,  desc: "转场持续帧数"}
+      - {name: frame_start,  dir: in,  width: 1}
+      - {name: x,            dir: in,  width: 10}
+      - {name: y,            dir: in,  width: 10}
+      - {name: de,           dir: in,  width: 1}
+      - {name: rgb_cur,      dir: in,  width: 24, desc: "当前帧缓存像素"}
+      - {name: rgb_next,     dir: in,  width: 24, desc: "下一帧缓存像素（仅淡入淡出用）"}
+      - {name: rgb_out,      dir: out, width: 24}
+      - {name: need_second,  dir: out, width: 1,  desc: "高电平时第二路帧读取器必须工作"}
+      - {name: busy,         dir: out, width: 1}
+      - {name: done,         dir: out, width: 1}
+
+  font_rom:
+    file: rtl/font_rom.v
+    domain: clk_pix
+    desc: >
+      字模 ROM。三段合一：ASCII 8x16（96 个）、中文子集 16x16（最多 128 个）、
+      大号数字/字母 32x48（最多 40 个）。用 $readmemh 从 rtl/font_rom.hex 初始化，
+      该 hex 由 tools/font_subset.py 生成。同步读，1 拍延迟。
+    params:
+      - {name: ADDR_W, default: 14}
+      - {name: HEXFILE, default: "font_rom.hex"}
+    ports:
+      - {name: clk,   dir: in,  width: 1}
+      - {name: addr,  dir: in,  width: ADDR_W, desc: "行地址：每行 32 bit"}
+      - {name: dout,  dir: out, width: 32, desc: "该行点阵，MSB 在左"}
+
+  osd_renderer:
+    file: rtl/osd_renderer.v
+    domain: clk_pix
+    desc: >
+      行缓冲式 OSD 渲染。在显示第 N 行时把第 N+1 行渲染进乒乓行缓冲。
+      支持 16 个文字域，每域可独立设置位置、字号倍率、颜色、闪烁。
+      输出与像素流严格对齐的 osd_rgb / osd_alpha。
+    ports:
+      - {name: clk,          dir: in,  width: 1}
+      - {name: rst_n,        dir: in,  width: 1}
+      - {name: x,            dir: in,  width: 10}
+      - {name: y,            dir: in,  width: 10}
+      - {name: de,           dir: in,  width: 1}
+      - {name: line_start,   dir: in,  width: 1}
+      - {name: frame_start,  dir: in,  width: 1}
+      - {name: frame_cnt,    dir: in,  width: 16, desc: "用于闪烁相位"}
+      - {name: qstate,       dir: in,  width: 128}
+      - {name: param,        dir: in,  width: 64}
+      - {name: cfg_we,       dir: in,  width: 1,  desc: "clk_pix 域写口（上游已做 CDC）"}
+      - {name: cfg_addr,     dir: in,  width: 10}
+      - {name: cfg_wdata,    dir: in,  width: 32}
+      - {name: font_addr,    dir: out, width: 14}
+      - {name: font_dout,    dir: in,  width: 32}
+      - {name: osd_rgb,      dir: out, width: 24}
+      - {name: osd_alpha,    dir: out, width: 8, desc: "0=完全透明 255=完全不透明"}
+
+  osd_compositor:
+    file: rtl/osd_compositor.v
+    domain: clk_pix
+    desc: >
+      最终合成级。顺序：底图 -> 亮度/对比度调节 -> OSD 文字层 alpha 混合 ->
+      频谱层 alpha 混合 -> 输出。亮度为加性偏置（param.brightness-128），
+      对比度为乘性增益（Q4.4，param.contrast 128 对应 1.0），运算后饱和截断到 0..255。
+    ports:
+      - {name: clk,         dir: in,  width: 1}
+      - {name: rst_n,       dir: in,  width: 1}
+      - {name: de_in,       dir: in,  width: 1}
+      - {name: hs_in,       dir: in,  width: 1}
+      - {name: vs_in,       dir: in,  width: 1}
+      - {name: rgb_base,    dir: in,  width: 24}
+      - {name: osd_rgb,     dir: in,  width: 24}
+      - {name: osd_alpha,   dir: in,  width: 8}
+      - {name: spec_rgb,    dir: in,  width: 24}
+      - {name: spec_alpha,  dir: in,  width: 8}
+      - {name: param,       dir: in,  width: 64}
+      - {name: de_out,      dir: out, width: 1}
+      - {name: hs_out,      dir: out, width: 1}
+      - {name: vs_out,      dir: out, width: 1}
+      - {name: rgb_out,     dir: out, width: 24}
+
+  bilinear_scaler:
+    file: rtl/bilinear_scaler.v
+    domain: clk_sys
+    desc: >
+      双线性缩放，作用在载入路径（不是显示路径）：把任意 src_w x src_h 的解码像素流
+      缩放到 640x480 后再写 SDRAM。用两行行缓冲，定点步进 Q16.16。
+      这样显示侧永远是 640x480，带宽和时序都不受源图尺寸影响。
+    ports:
+      - {name: clk,       dir: in,  width: 1}
+      - {name: rst_n,     dir: in,  width: 1}
+      - {name: bypass,    dir: in,  width: 1,  desc: "源图恰为 640x480 时直通"}
+      - {name: src_w,     dir: in,  width: 11}
+      - {name: src_h,     dir: in,  width: 11}
+      - {name: in_valid,  dir: in,  width: 1}
+      - {name: in_ready,  dir: out, width: 1, desc: "仅在本拍可接收像素时拉高"}
+      - {name: in_rgb,    dir: in,  width: 24}
+      - {name: in_x,      dir: in,  width: 11}
+      - {name: in_y,      dir: in,  width: 11}
+      - {name: in_last,   dir: in,  width: 1}
+      - {name: out_ready, dir: in, width: 1, desc: "输出反压，停顿时保持坐标和颜色"}
+      - {name: out_valid, dir: out, width: 1}
+      - {name: out_rgb,   dir: out, width: 24}
+      - {name: out_x,     dir: out, width: 10}
+      - {name: out_y,     dir: out, width: 10}
+      - {name: out_last,  dir: out, width: 1}
+
+  # ---------------- D 组：业务控制 ----------------
+  queue_fsm:
+    file: rtl/queue_fsm.v
+    domain: clk_sys
+    desc: >
+      叫号队列状态机。4 个诊室，普通队列与优先队列各一。
+      公平策略：优先号先服务，但连续服务优先号不超过 PRIO_BURST 个，之后必须让一个普通号，防止普通队列饿死。
+      支持：叫下一号、重呼（不推进队列，repeat_cnt+1）、过号（当前号作废并回写到普通队列尾部）、
+      自动模式（每 AUTO_PERIOD 个时钟自动叫号并模拟患者到达）。
+    params:
+      - {name: ROOMS,       default: 4}
+      - {name: PRIO_BURST,  default: 2}
+      - {name: AUTO_PERIOD, default: 250000000, desc: "5 秒 @50MHz"}
+    ports:
+      - {name: clk,          dir: in,  width: 1}
+      - {name: rst_n,        dir: in,  width: 1}
+      - {name: ev_next,      dir: in,  width: 1, desc: "叫下一号"}
+      - {name: ev_recall,    dir: in,  width: 1, desc: "重呼"}
+      - {name: ev_skip,      dir: in,  width: 1, desc: "过号"}
+      - {name: ev_page,      dir: in,  width: 1, desc: "切换页面"}
+      - {name: ev_arrive,    dir: in,  width: 1, desc: "新患者取号"}
+      - {name: sw_priority,  dir: in,  width: 1, desc: "取号时标记为优先号"}
+      - {name: sw_auto,      dir: in,  width: 1, desc: "自动叫号模式"}
+      - {name: sw_access,    dir: in,  width: 1, desc: "适老化模式"}
+      - {name: restore_req,  dir: in,  width: 1, desc: "上电从 Flash 恢复队列"}
+      - {name: restore_data, dir: in,  width: 128}
+      - {name: persist_data, dir: out, width: 128, desc: "要保存到 Flash 的状态"}
+      - {name: persist_req,  dir: out, width: 1,  desc: "状态变化，请求持久化"}
+      - {name: qstate,       dir: out, width: 128, desc: "见 qstate_bus"}
+      - {name: call_pulse,   dir: out, width: 1,  desc: "发生一次叫号，触发语音与延迟测量"}
+      - {name: call_ticket,  dir: out, width: 16, desc: "本次叫号票号 BCD"}
+      - {name: call_room,    dir: out, width: 4}
+      - {name: call_prio,    dir: out, width: 1}
+
+  uart_rx:
+    file: rtl/uart_rx.v
+    domain: clk_sys
+    params: [{name: CLK_HZ, default: 50000000}, {name: BAUD, default: 115200}]
+    ports:
+      - {name: clk,      dir: in,  width: 1}
+      - {name: rst_n,    dir: in,  width: 1}
+      - {name: rxd,      dir: in,  width: 1}
+      - {name: out_valid,dir: out, width: 1}
+      - {name: out_data, dir: out, width: 8}
+      - {name: frame_err,dir: out, width: 1}
+
+  uart_tx:
+    file: rtl/uart_tx.v
+    domain: clk_sys
+    params: [{name: CLK_HZ, default: 50000000}, {name: BAUD, default: 115200}]
+    ports:
+      - {name: clk,     dir: in,  width: 1}
+      - {name: rst_n,   dir: in,  width: 1}
+      - {name: in_valid,dir: in,  width: 1}
+      - {name: in_ready,dir: out, width: 1}
+      - {name: in_data, dir: in,  width: 8}
+      - {name: txd,     dir: out, width: 1}
+
+  uart_cmd:
+    file: rtl/uart_cmd.v
+    domain: clk_sys
+    desc: >
+      调试命令解析。帧格式：0x55 0xAA CMD ROOM TICKET_H TICKET_L PARAM CRC8。
+      CRC8 多项式 0x07，初值 0x00，覆盖 CMD..PARAM 共 5 字节。
+      CMD: 0x01 叫下一号 0x02 重呼 0x03 过号 0x04 取号 0x05 设置参数 0x06 切页。
+      校验失败丢弃整帧并回 0x15，成功回 0x06。UART 仅用于调试，最终作品不依赖它运行。
+    ports:
+      - {name: clk,       dir: in,  width: 1}
+      - {name: rst_n,     dir: in,  width: 1}
+      - {name: rx_valid,  dir: in,  width: 1}
+      - {name: rx_data,   dir: in,  width: 8}
+      - {name: tx_valid,  dir: out, width: 1}
+      - {name: tx_ready,  dir: in,  width: 1}
+      - {name: tx_data,   dir: out, width: 8}
+      - {name: cmd_next,  dir: out, width: 1}
+      - {name: cmd_recall,dir: out, width: 1}
+      - {name: cmd_skip,  dir: out, width: 1}
+      - {name: cmd_arrive,dir: out, width: 1}
+      - {name: cmd_page,  dir: out, width: 1}
+      - {name: cmd_param_we,  dir: out, width: 1}
+      - {name: cmd_param_sel, dir: out, width: 4}
+      - {name: cmd_param_val, dir: out, width: 8}
+
+  seg_scan:
+    file: rtl/seg_scan.v
+    domain: clk_sys
+    desc: "8 位数码管动态扫描，1 kHz 单位刷新。段码共阳/共阴由 SEG_ACTIVE_LOW 参数控制。"
+    params:
+      - {name: CLK_HZ, default: 50000000}
+      - {name: SCAN_HZ, default: 1000}
+      - {name: SEG_ACTIVE_LOW, default: 1}
+      - {name: SEL_ACTIVE_LOW, default: 1}
+    ports:
+      - {name: clk,      dir: in,  width: 1}
+      - {name: rst_n,    dir: in,  width: 1}
+      - {name: digits,   dir: in,  width: 32, desc: "8 个 4-bit 值，digit0 在低位"}
+      - {name: dp,       dir: in,  width: 8,  desc: "小数点"}
+      - {name: blank,    dir: in,  width: 8,  desc: "1=该位熄灭"}
+      - {name: seg_data, dir: out, width: 8,  desc: "{dp,g,f,e,d,c,b,a}"}
+      - {name: seg_sel,  dir: out, width: 8}
+
+  buzzer:
+    file: rtl/buzzer.v
+    domain: clk_sys
+    desc: "蜂鸣器提示音。三种音型：普通叫号双响、重呼三响、优先号长响。"
+    params: [{name: CLK_HZ, default: 50000000}]
+    ports:
+      - {name: clk,     dir: in,  width: 1}
+      - {name: rst_n,   dir: in,  width: 1}
+      - {name: trig,    dir: in,  width: 1}
+      - {name: pattern, dir: in,  width: 2, desc: "0=普通 1=重呼 2=优先"}
+      - {name: mute,    dir: in,  width: 1}
+      - {name: beep,    dir: out, width: 1}
+      - {name: busy,    dir: out, width: 1}
+
+  param_ctrl:
+    file: rtl/param_ctrl.v
+    domain: clk_sys
+    desc: >
+      实时参数调节。KEY 组合 + 拨码选择当前调节项，长按连续增减。
+      输出 param_bus，并产生一个 OSD 提示，3 秒后自动隐藏。
+    ports:
+      - {name: clk,          dir: in,  width: 1}
+      - {name: rst_n,        dir: in,  width: 1}
+      - {name: key_press,    dir: in,  width: 4}
+      - {name: key_hold,     dir: in,  width: 4}
+      - {name: sw,           dir: in,  width: 4}
+      - {name: ext_we,       dir: in,  width: 1, desc: "来自 uart_cmd"}
+      - {name: ext_sel,      dir: in,  width: 4}
+      - {name: ext_val,      dir: in,  width: 8}
+      - {name: param,        dir: out, width: 64}
+      - {name: osd_hint_id,  dir: out, width: 4, desc: "当前正在调节哪一项，0=无"}
+      - {name: osd_hint_val, dir: out, width: 8}
+      - {name: osd_hint_vis, dir: out, width: 1}
+
+  # ---------------- E 组：音频 ----------------
+  audio_sample_clk:
+    file: rtl/audio_sample_clk.v
+    domain: clk_pix
+    desc: >
+      由 clk_pix 用分数累加器产生精确 48 kHz 选通。
+      累加器每拍加 ACC_INC，溢出即产生 stb。ACC_INC = 48000 * 2^32 / 25000000 = 8246337.2,
+      取 8246337 时误差 < 0.03 ppm，与 ACR 的 N/CTS 比值一致，构造上不漂移。
+    params:
+      - {name: ACC_W,   default: 32}
+      - {name: ACC_INC, default: 8246337}
+    ports:
+      - {name: clk,   dir: in,  width: 1}
+      - {name: rst_n, dir: in,  width: 1}
+      - {name: stb,   dir: out, width: 1}
+
+  audio_tone_gen:
+    file: rtl/audio_tone_gen.v
+    domain: clk_pix
+    desc: "48 kHz 测试音与提示音。1/4 周期正弦查表 256 点，相位累加器合成任意频率。满足基础要求 3 的测试音。"
+    ports:
+      - {name: clk,       dir: in,  width: 1}
+      - {name: rst_n,     dir: in,  width: 1}
+      - {name: stb,       dir: in,  width: 1}
+      - {name: enable,    dir: in,  width: 1}
+      - {name: freq_inc,  dir: in,  width: 24, desc: "相位增量，f = freq_inc * 48000 / 2^24"}
+      - {name: amplitude, dir: in,  width: 8}
+      - {name: sample,    dir: out, width: 16, desc: "有符号"}
+
+  audio_pcm_player:
+    file: rtl/audio_pcm_player.v
+    domain: clk_pix
+    desc: >
+      从 SDRAM AUDIO_POOL 播放语音片段。素材为 16 kHz 16-bit 单声道，2 样本/32-bit 字。
+      播放时用线性插值 3 倍上采样到 48 kHz（相位累加器 1/3 步进）。
+      跨 clk_mem -> clk_pix 用异步 FIFO，深度 >= 512 样本，保证不欠载。
+    ports:
+      - {name: clk_pix,    dir: in,  width: 1}
+      - {name: rst_n_pix,  dir: in,  width: 1}
+      - {name: clk_mem,    dir: in,  width: 1}
+      - {name: rst_n_mem,  dir: in,  width: 1}
+      - {name: stb,        dir: in,  width: 1}
+      - {name: play_req,   dir: in,  width: 1}
+      - {name: play_base,  dir: in,  width: 22}
+      - {name: play_samples,dir: in, width: 22}
+      - {name: play_busy,  dir: out, width: 1}
+      - {name: play_done,  dir: out, width: 1}
+      - {name: sample,     dir: out, width: 16}
+      - {name: underrun,   dir: out, width: 1}
+      - {name: aud_req_valid, dir: out, width: 1}
+      - {name: aud_req_ready, dir: in,  width: 1}
+      - {name: aud_req_addr,  dir: out, width: 22}
+      - {name: aud_req_we,    dir: out, width: 1}
+      - {name: aud_req_len,   dir: out, width: 9}
+      - {name: aud_wr_valid,  dir: out, width: 1}
+      - {name: aud_wr_ready,  dir: in,  width: 1}
+      - {name: aud_wr_data,   dir: out, width: 32}
+      - {name: aud_rd_valid,  dir: in,  width: 1}
+      - {name: aud_rd_ready,  dir: out, width: 1}
+      - {name: aud_rd_data,   dir: in,  width: 32}
+
+  audio_announcer:
+    file: rtl/audio_announcer.v
+    domain: clk_pix
+    desc: >
+      叫号语音编排器。收到 call_pulse 后，把一次播报拆成片段序列并依次请求 pcm 播放：
+      提示音 -> 字母 -> 百位 -> 十位 -> 个位 -> "号请到" -> 诊室号 -> "诊室就诊"。
+      片段索引到 SDRAM 地址的映射由 asset_loader 的 clip_base/clip_samples 查询端口提供。
+    params: [{name: MAX_STEPS, default: 12}]
+    ports:
+      - {name: clk,          dir: in,  width: 1}
+      - {name: rst_n,        dir: in,  width: 1}
